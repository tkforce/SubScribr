# Copy to .env.local and fill in. Never commit .env.local.
#
# The filename matters: prisma.config.ts and scripts/*.ts read `.env.local`
# explicitly via dotenv, so a plain `.env` will not be picked up by them.

# --- Database (Postgres, e.g. Supabase) ---------------------------------
# DATABASE_URL is the pooled connection the app uses at runtime.
# DIRECT_URL is the direct connection Prisma CLI uses for migrations.
# Both carry the same password — rotating it means updating both.
# URL-encode special characters in the password (@ -> %40, # -> %23, ...).
DATABASE_URL=
DIRECT_URL=

# --- NextAuth + Google OAuth --------------------------------------------
# AUTH_SECRET also derives the AES key that encrypts stored Gmail refresh
# tokens (src/lib/token-crypto.ts). Rotating it invalidates every stored
# token — users then have to reconnect Gmail. Generate with:
#   npx auth secret
AUTH_SECRET=

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID.
# Needs the Gmail read-only scope (gmail.readonly).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- LLM ------------------------------------------------------------------
# Read implicitly by @ai-sdk/google (see src/lib/llm.ts).
# Get a key at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
