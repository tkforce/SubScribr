# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real values never get committed, but the template must be,
# or a fresh clone has no way to know which variables the app needs.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude session scratch worktrees
.claude/

/src/generated/prisma
.vscode/settings.json

# extraction artifacts contain personal email content — never commit
/sampleEmail/
/docs/extractions/*
!/docs/extractions/PROMPT_LOG.md
!/docs/extractions/README.md

.superpowers/
