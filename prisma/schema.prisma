generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  gmailToken   String?
  createdAt    DateTime  @default(now())
  lastIngestAt DateTime?

  subscriptions Subscription[]
  billingEvents BillingEvent[]
  agentTraces   AgentTrace[]
  analysis      Analysis?
}

model Subscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  serviceName String
  displayName String?

  amount          Decimal
  currency        String
  amountInTwd     Decimal
  cycle           String
  nextBillingDate DateTime?
  category        String

  status      String    @default("active")
  cancelledAt DateTime?
  hiddenAt    DateTime?

  source String @default("gmail")

  isTrial     Boolean   @default(false)
  trialEndsAt DateTime?

  firstSeenAt DateTime
  lastSeenAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  billingEvents BillingEvent[]

  @@unique([userId, serviceName])
  @@index([userId, status])
}

model BillingEvent {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

  gmailMessageId  String   @unique
  emailReceivedAt DateTime

  rawServiceName  String
  serviceName     String
  amount          Decimal
  currency        String
  amountInTwd     Decimal
  cycle           String
  // LLM-assigned category; null when the LLM omitted it. Nullable (not
  // defaulted) so pre-existing rows read as "unknown", not a fake "other".
  category        String?
  emailSignalType String

  promptVersion String

  createdAt DateTime @default(now())

  @@index([userId, serviceName, emailReceivedAt(sort: Desc)])
  @@index([userId, emailReceivedAt])
}

model AgentTrace {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  section      String
  steps        Json
  totalTokens  Int
  totalCostUsd Decimal
  status       String

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// The AI dashboard section's result. A derived view of the BillingEvent log,
// exactly like Subscription — one current version per user, replaced whole on
// each run rather than accumulated. There is no `section` column because 8a
// and 8b were merged into one analysis.
//
// payload is the Zod-validated Analysis object (headline / insights /
// observation / recommendations). Kept as JSON rather than child tables
// because it is always read whole to render and never queried by its
// internals — the opposite of BillingEvent, which exists to be aggregated.
model Analysis {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  payload Json

  // The user.lastIngestAt this analysis was derived from. Staleness is
  // "the log moved on since this ran", so this is the only freshness key.
  basedOnIngestAt DateTime
  promptVersion   String

  generatedAt DateTime @default(now())
}
